<!DOCTYPE html>
<html lang="{{ site.language or 'en' }}">
<head>
  {% include "partials/head.njk" %}
</head>
<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2">
    Skip to content
  </a>

  <header class="border-b border-slate-200 bg-white">
    <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-5" aria-label="Primary">
      <a href="/" class="text-xl font-semibold tracking-tight text-slate-900">{{ site.title }}</a>
      <div class="flex gap-6 text-sm font-medium text-slate-600">
        <a href="/" class="hover:text-slate-900">Home</a>
        <a href="/about" class="hover:text-slate-900">About</a>
        <a href="/blog" class="hover:text-slate-900">Blog</a>
      </div>
    </nav>
  </header>

  <main id="main" class="mx-auto max-w-3xl px-4 py-12">
    {% block content %}{% endblock %}
  </main>

  <footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-3xl px-4 py-8 text-center text-sm text-slate-500">
      <p>&copy; {{ 'now' | date('yyyy') }} {{ site.title }}{% if site.author %} · {{ site.author }}{% endif %}</p>
      <p class="mt-2">Built with Simple Engine</p>
    </div>
  </footer>
</body>
</html>
