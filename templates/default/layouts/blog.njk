{% extends "base.njk" %}

{% block content %}
<section>
  <header class="mb-10">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">{{ title }}</h1>
    {% if description %}
    <p class="mt-3 text-lg text-slate-600">{{ description }}</p>
    {% endif %}
  </header>

  <div class="prose prose-slate prose-lg max-w-none mb-12">
    {{ content | safe }}
  </div>

  <div class="space-y-6">
    {% for post in collections.posts %}
    <article class="border-b border-slate-200 pb-6">
      <h2 class="text-2xl font-semibold tracking-tight">
        <a href="{{ post.url }}" class="text-slate-900 hover:underline">{{ post.data.title }}</a>
      </h2>
      {% if post.data.date %}
      <time class="mt-1 block text-sm text-slate-500" datetime="{{ post.data.date }}">
        {{ post.data.date | date('MMMM d, yyyy') }}
      </time>
      {% endif %}
      {% if post.data.description %}
      <p class="mt-2 text-slate-600">{{ post.data.description }}</p>
      {% endif %}
    </article>
    {% else %}
    <p class="text-slate-600">No posts yet. Create one with <code>simple new post "My Post"</code>.</p>
    {% endfor %}
  </div>
</section>
{% endblock %}
